#!/usr/bin/env python3
# omabot-watch - follows Grok Bot's local state and streams it as JSON lines.
#
#   stdout  {"generated_ts":…, "counts":{…}, "sections":[…], "bots":[…]}
#   cache   ~/.local/state/omarchy/omabot/avatars/<version>.png for bots that
#           wear a picture instead of a shape
#   args    --interval N   seconds between checks (default 2)
#           --focus        raise Grok Bot (or launch it); used by the widget
#
# Grok Bot keeps its client state in ~/.config/Grok Bot/sand-client-persistence
# as blobs whose filenames are base32 of the state key, rewritten whenever
# something changes. Nothing here is a documented contract - the roster is at
# schemaVersion 4 - so every field is read defensively and a shape we do not
# recognise degrades to "no bots" rather than crashing the widget.
import base64
import json
import os
import re
import subprocess
import sys
import time

STATE = os.path.expanduser("~/.config/Grok Bot")
PERSIST = os.path.join(STATE, "sand-client-persistence")
MARKER = os.path.join(STATE, "sand-session-marker.json")
# Where decoded avatar images are kept. Grok Bot stores them as base64 data
# URLs in one blob; QML wants files, and a 200KB string per bot has no business
# going through a JSON line every couple of seconds.
CACHE = os.path.expanduser("~/.local/state/omarchy/omabot/avatars")
# Grok Bot's data URL is untrusted local JSON. Cap decode size and require a
# single path component so a hostile version cannot write outside CACHE.
MAX_AVATAR_BYTES = 2 * 1024 * 1024
_AVATAR_VERSION_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
_WINDOW_ADDR_RE = re.compile(r"^0x[0-9a-fA-F]{1,16}$")

# Avatar palette, lifted from the app bundle so the widget matches it exactly.
COLORS = {
    "red": "#FF263C", "orange": "#FF6700", "yellow": "#FF9800", "green": "#00C972",
    "cyan": "#00BCA6", "blue": "#1084FE", "violet": "#9159FE", "magenta": "#FF309B",
    "brown": "#936439", "gray": "#777777",
}


def decode_key(path):
    name = os.path.basename(path)
    if not name.endswith(".blob"):
        return ""
    name = name[:-5]
    try:
        return base64.b32decode(name.upper() + "=" * ((8 - len(name) % 8) % 8)).decode("utf-8", "replace")
    except Exception:
        return ""


def blobs():
    """key -> (path, mtime) for every persistence blob."""
    out = {}
    try:
        for entry in os.scandir(PERSIST):
            if not entry.name.endswith(".blob"):
                continue
            key = decode_key(entry.path)
            if key:
                out[key] = (entry.path, entry.stat().st_mtime)
    except OSError:
        pass
    return out


def load(index, suffix):
    """Value of the first blob whose key ends with `suffix`."""
    for key, (path, _) in index.items():
        if key.endswith(suffix):
            try:
                with open(path, "rb") as f:
                    return json.load(f).get("value")
            except (OSError, ValueError):
                return None
    return None


# A bot is working when its transcript ends on a user message it has not
# answered yet. The app streams replies over its gateway and only persists the
# finished message, so this is the honest local signal - and it is the same
# window the app itself shows a busy avatar for. Parsing is cached by mtime:
# transcripts are large and only change when something happens.
_transcripts = {}


def working_state(index, bot_id, now):
    entry = None
    for key, (path, mtime) in index.items():
        if key.endswith("transcript.replicas." + str(bot_id)):
            entry = (path, mtime)
            break
    if not entry:
        return False, 0.0
    path, mtime = entry
    cached = _transcripts.get(bot_id)
    if not cached or cached[0] != mtime:
        try:
            with open(path, "rb") as f:
                entries = json.load(f).get("value", {}).get("entries") or []
        except (OSError, ValueError):
            entries = []
        last_user = 0.0
        for e in reversed(entries):
            kind = e.get("kind")
            if kind == "send-message":          # the bot answered after it
                break
            if kind == "message" and e.get("role") == "user":
                last_user = (e.get("timestampMs") or 0) / 1000.0
                break
        _transcripts[bot_id] = (mtime, last_user)
        cached = _transcripts[bot_id]
    since = cached[1]
    # Cap it: a reply that never came should not leave a bot working forever.
    return bool(since and now - since < 900), since


# Bots with a picture instead of a shape: the roster gives them a null shape
# and colour and an avatarVersion, and the picture itself lives in a separate
# blob as a data URL. Decode each one once, to a file named for its version, so
# a changed picture writes a new file and an unchanged one costs nothing.
_avatars = (None, {})


def _avatar_filename(version, ext):
    """Return a CACHE-relative name, or None if version/ext cannot be trusted."""
    name = str(version)
    if name in (".", "..") or ".." in name or not _AVATAR_VERSION_RE.fullmatch(name):
        return None
    if ext not in ("png", "jpg", "img"):
        return None
    return "%s.%s" % (name, ext)


def _ensure_cache():
    os.makedirs(CACHE, mode=0o700, exist_ok=True)
    try:
        os.chmod(CACHE, 0o700)
    except OSError:
        pass


def _in_cache(path):
    cache = os.path.abspath(CACHE)
    dest = os.path.abspath(path)
    return os.path.dirname(dest) == cache


def avatars(index):
    """bot id -> path of its decoded avatar image."""
    global _avatars
    entry = None
    for key, (path, mtime) in index.items():
        if key.endswith("roster.agent-avatars"):
            entry = (path, mtime)
            break
    if not entry:
        return {}
    path, mtime = entry
    if _avatars[0] == mtime:
        return _avatars[1]
    out = {}
    try:
        with open(path, "rb") as f:
            entries = json.load(f).get("value", {}).get("entries") or []
    except (OSError, ValueError):
        entries = []
    _ensure_cache()
    for e in entries:
        bot_id, version, url = e.get("id"), e.get("version"), e.get("dataUrl") or ""
        if not bot_id or not version or "," not in url:
            continue
        head, b64 = url.split(",", 1)
        ext = "png" if "png" in head else ("jpg" if "jpeg" in head or "jpg" in head else "img")
        filename = _avatar_filename(version, ext)
        if not filename:
            continue
        dest = os.path.join(CACHE, filename)
        if not _in_cache(dest):
            continue
        if not os.path.exists(dest):
            try:
                b64 = "".join(b64.split())
                if len(b64) > MAX_AVATAR_BYTES * 4 // 3 + 64:
                    continue
                raw = base64.b64decode(b64, validate=True)
                if not raw or len(raw) > MAX_AVATAR_BYTES:
                    continue
                tmp = dest + ".part"
                if not _in_cache(tmp):
                    continue
                with open(tmp, "wb") as f:
                    f.write(raw)
                os.replace(tmp, dest)
            except (OSError, ValueError):
                continue
        out[bot_id] = dest
    # Drop pictures nobody wears any more, so changing an avatar twice does not
    # leave two dead files behind. Only unlink regular files we would have
    # written (legal avatar names, or leftover *.part temps).
    keep = set(os.path.basename(p) for p in out.values())
    try:
        for name in os.listdir(CACHE):
            if name in keep:
                continue
            victim = os.path.join(CACHE, name)
            if not _in_cache(victim) or not os.path.isfile(victim) or os.path.islink(victim):
                continue
            stem_ext = name.rsplit(".", 1)
            legal = len(stem_ext) == 2 and _avatar_filename(stem_ext[0], stem_ext[1])
            if legal or name.endswith(".part"):
                os.remove(victim)
    except OSError:
        pass
    _avatars = (mtime, out)
    return out


def marker():
    try:
        with open(MARKER) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {"running": False}
    alive = data.get("aliveAtMs", 0) / 1000.0
    return {
        "running": (time.time() - alive) < 120,
        "version": data.get("appVersion"),
        "pid": data.get("pid"),
        "started_ts": (data.get("startedAtMs") or 0) / 1000.0,
        "alive_ts": alive,
        "crash_seen": bool(data.get("crashSeen")),
    }


def snapshot(index):
    roster = load(index, "roster.last-roster") or {}
    rows = roster.get("rows") if isinstance(roster, dict) else None
    if not isinstance(rows, list):
        rows = []
    sections = (load(index, "sidebar.last-sections") or {}).get("sections") or []
    selection = (load(index, "selection.last-agent") or {}).get("agentId")
    refs = load(index, "ui-agent-refs") or {}
    pinned = refs.get("pinnedAgentIds") or []

    now = time.time()
    pictures = avatars(index)
    bots = []
    for row in rows:
        if not isinstance(row, dict) or row.get("isHiddenFromSidebar"):
            continue
        entry = row.get("lastEntry") or {}
        last_text = entry.get("text") or entry.get("kind") or ""
        color = row.get("avatarColor")
        working, working_since = working_state(index, row.get("id"), now)
        bots.append({
            "id": row.get("id"),
            "name": row.get("name") or "(unnamed)",
            "title": row.get("title") or "",
            "description": row.get("description") or "",
            "shape": row.get("avatarShape") or ("group" if row.get("isGroup") else "squircle"),
            "color": color,
            # A picture wins over the shape, the way it does in the app.
            "avatar": pictures.get(row.get("id")) if row.get("avatarVersion") else None,
            "hex": COLORS.get(color or "", None),
            "is_group": bool(row.get("isGroup")),
            "members": len(row.get("memberIds") or []),
            "unread": int(row.get("unreadCount") or 0),
            "awaiting": bool(row.get("awaitingUserResponse")),
            "working": working,
            "working_since_ts": working_since,
            "muted": not row.get("notificationsEnabled", False),
            "last_text": last_text[:160],
            "last_activity_ts": (row.get("lastActivityAt") or 0) / 1000.0,
            "last_viewed_ts": (row.get("lastViewedAt") or 0) / 1000.0,
            "focused": row.get("id") == selection,
            "pinned": row.get("id") in pinned,
        })

    by_id = {b["id"]: b for b in bots}
    grouped, seen = [], set()
    for section in sections if isinstance(sections, list) else []:
        ids = [i for i in (section.get("agentIds") or []) if i in by_id]
        seen.update(ids)
        if ids or section.get("id") != "__agents__":
            grouped.append({"id": section.get("id"), "name": section.get("name") or "", "bot_ids": ids})
    loose = [b["id"] for b in bots if b["id"] not in seen]
    if loose:
        grouped.append({"id": "__loose__", "name": "Unassigned", "bot_ids": loose})

    counts = {
        "bots": len(bots),
        "awaiting": sum(1 for b in bots if b["awaiting"]),
        "working": sum(1 for b in bots if b["working"]),
        "unread": sum(1 for b in bots if b["unread"] > 0),
        "unread_messages": sum(b["unread"] for b in bots),
        "groups": sum(1 for b in bots if b["is_group"]),
    }
    return {"generated_ts": time.time(), "app": marker(), "counts": counts,
            "sections": grouped, "bots": bots}


def _run(argv, timeout=2):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None


def focus_app():
    """Raise the Grok Bot window, or launch the app. Never goes through a shell."""
    addr = ""
    proc = _run(["hyprctl", "clients", "-j"])
    if proc and proc.stdout:
        try:
            clients = json.loads(proc.stdout)
        except ValueError:
            clients = []
        if isinstance(clients, list):
            for c in clients:
                if not isinstance(c, dict) or c.get("class") != "grok-bot":
                    continue
                cand = str(c.get("address") or "")
                if _WINDOW_ADDR_RE.fullmatch(cand):
                    addr = cand
                    break
    if addr:
        target = "address:" + addr
        # Omarchy's Lua dispatcher first; classic Hyprland focuswindow as fallback.
        lua = 'hl.dsp.focus({ window = "%s" })' % target
        r = _run(["hyprctl", "dispatch", lua])
        if r is None or r.returncode != 0:
            _run(["hyprctl", "dispatch", "focuswindow", target])
        return
    try:
        subprocess.Popen(["uwsm-app", "--", "gtk-launch", "grok-bot"], start_new_session=True)
    except OSError:
        pass


def main():
    args = sys.argv[1:]
    if "--focus" in args:
        focus_app()
        return
    interval = 2.0
    if "--interval" in args:
        try:
            interval = max(0.5, float(args[args.index("--interval") + 1]))
        except (IndexError, ValueError):
            pass

    last_signature = None
    last_emit = 0.0
    while True:
        index = blobs()
        # Cheap change detection: the roster/marker mtimes plus the blob count.
        signature = (
            len(index),
            tuple(sorted((k, m) for k, (_, m) in index.items()
                         if k.endswith(("last-roster", "last-sections", "last-agent",
                                        "ui-agent-refs", "agent-avatars"))
                         or "transcript.replicas." in k)),
            os.path.getmtime(MARKER) if os.path.exists(MARKER) else 0,
        )
        now = time.time()
        # Emit on change, and at least once a minute so "app quit" is noticed.
        if signature != last_signature or now - last_emit > 60:
            try:
                sys.stdout.write(json.dumps(snapshot(index), separators=(",", ":")) + "\n")
                sys.stdout.flush()
            except BrokenPipeError:
                return
            last_signature, last_emit = signature, now
        time.sleep(interval)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
